---
// Frame part: the Section Links, one cell per Section beside "Let's talk".
// Desktop only; on mobile the top bar has no room and the page is one scroll.
import { site } from '../../data/site';
---

<nav class="section-links" aria-label={site.frame.sectionLinks.label}>
  {site.frame.sectionLinks.links.map(({ text, href }) => <a href={href}>{text}</a>)}
</nav>

<style>
  .section-links {
    display: none;
  }

  @media (min-width: 48rem) {
    .section-links {
      display: flex;
      margin-left: auto;
    }
  }

  a {
    display: flex;
    align-items: center;
    padding-inline: clamp(1rem, 2vw, 1.75rem);
    border-left: var(--line) solid var(--ink);
    font-family: var(--font-heading);
    font-size: var(--text-label);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    outline-offset: -6px;
  }

  @media (hover: hover) {
    a:hover {
      background: var(--ink);
      color: var(--field);
    }
  }

  a:active {
    background: var(--ink);
    color: var(--paper);
  }
</style>
