---
// Frame part: the Monogram on the left of the top bar. Links back to the top.
import Monogram from '../Monogram.astro';
import { site } from '../../data/site';
---

<a class="monogram-link" href="#top" aria-label={site.frame.monogramLabel}>
  <Monogram />
</a>

<style>
  .monogram-link {
    display: flex;
    align-items: center;
    padding-inline: clamp(1rem, 2vw, 1.75rem);
    font-size: calc(var(--bar-h) * 0.46);
    outline-offset: -6px;
  }

  .monogram-link :global(.monogram) {
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }

  @media (hover: hover) {
    .monogram-link:hover {
      background: var(--ink);
      color: var(--field);
    }
    .monogram-link:hover :global(.monogram) {
      transform: rotate(-6deg) scale(1.08);
    }
  }

  .monogram-link:active {
    background: var(--ink);
    color: var(--paper);
  }
  .monogram-link:active :global(.monogram) {
    transform: scale(0.9);
  }

  @media (prefers-reduced-motion: reduce) {
    .monogram-link :global(.monogram) {
      transition: none;
    }
  }
</style>
