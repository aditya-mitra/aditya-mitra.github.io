---
// The Monogram: the "AM" mark, drawn as SVG. Decorative on its own; whatever
// wraps it (a link, the footer) supplies the accessible name.
// Colour follows the surrounding text colour.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['monogram', className]} viewBox="0 0 49 32" aria-hidden="true" focusable="false">
  <path
    fill="currentColor"
    fill-rule="evenodd"
    d="M0 32 9 0h8l9 32h-7l-1.5-7h-9L7 32Zm10-13h6L13 7ZM28 32V0h7l3.5 14L42 0h7v32h-6V13l-2.5 11h-4L34 13v19Z"
  ></path>
</svg>

<style>
  .monogram {
    height: 1em;
    width: auto;
  }
</style>
