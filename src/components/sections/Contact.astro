---
// Contact Section: the curved sign-off headline, the email address as the main
// call to action, and the LinkedIn and GitHub links, over the Contact Scene.
//
// Room for ticket 09: the content is packed at the top and the Section keeps
// `--contact-scene-room` of empty height below it for the keyboard Scene, which
// is absolutely positioned behind (ContactScene). The typed readout goes in the
// marked slot at the end of `.contact__inner`.
import ContactScene from '../scenes/ContactScene.astro';
import { site } from '../../data/site';

const { contact } = site;
const { email, linkedin, github } = contact.links;
const headline = contact.heading.toUpperCase();
---

<section id="contact" class="section contact" aria-label={contact.label}>
  <ContactScene />
  <div class="contact__inner">
    <h2 class="contact__heading">
      <span class="visually-hidden">{contact.heading}</span>
      <svg
        class="contact__arc"
        data-testid="contact-headline"
        viewBox="0 0 1000 330"
        aria-hidden="true"
        focusable="false"
      >
        <path id="contact-arc-path" fill="none" d="M30 318Q500 20 970 318"></path>
        <text class="contact__arc-shadow" text-anchor="middle" dx="9" dy="9">
          <textPath href="#contact-arc-path" startOffset="50%">{headline}</textPath>
        </text>
        <text class="contact__arc-text" text-anchor="middle">
          <textPath href="#contact-arc-path" startOffset="50%">{headline}</textPath>
        </text>
      </svg>
    </h2>

    <a class="cta" href={email.href}>
      <span class="cta__top">
        <span class="cta__label">{email.label}</span>
        <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 12h17M13 5l7 7-7 7"></path>
        </svg>
      </span>
      <span class="cta__address" data-address>{email.text}</span>
    </a>

    <ul class="profiles">
      {
        [linkedin, github].map((link) => (
          <li>
            <a class="profile" href={link.href} target="_blank" rel="noopener noreferrer">
              <span class="profile__label">{link.label}</span>
              <span class="profile__text">{link.text}</span>
              <span class="visually-hidden">{contact.newTab}</span>
              <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 18 18 6M8 6h10v10" />
              </svg>
            </a>
          </li>
        ))
      }
      {
        contact.bookingUrl && (
          <li class="profiles__wide">
            <a class="profile" href={contact.bookingUrl} target="_blank" rel="noopener noreferrer">
              <span class="profile__label">{contact.bookingText}</span>
              <span class="visually-hidden">{contact.newTab}</span>
              <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 18 18 6M8 6h10v10" />
              </svg>
            </a>
          </li>
        )
      }
    </ul>

    {/* The keyboard Toy's readout: decorative, shown once the Toy loads. */}
    <p class="readout" aria-hidden="true" data-keyboard-readout data-message={contact.keyboardMessage}>
      <span class="readout__prompt">&gt;</span>
      <span class="readout__line"><span class="readout__text" data-testid="keyboard-readout"></span><span class="readout__caret"></span></span>
    </p>
  </div>
</section>

<style>
  .contact {
    /* Height kept free below the links for the keyboard Scene (ticket 09). */
    --contact-scene-room: clamp(16rem, min(46svh, 40vw + 8rem), 30rem);
    --shadow: clamp(4px, 0.5vw, 8px);
    padding-bottom: calc(var(--gutter) + var(--contact-scene-room));
  }

  .contact__inner {
    display: grid;
    gap: clamp(0.875rem, 1.6vw, 1.5rem);
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  /* The curved headline. The h2's text is the visually hidden span; the SVG
     is the same words set on an arc. */
  .contact__arc {
    width: 100%;
    height: auto;
    margin-bottom: clamp(0.25rem, 1vw, 1rem);
    overflow: visible;
    font-family: var(--font-heading);
    font-size: 205px;
    font-weight: 900;
    letter-spacing: 0.01em;
  }

  .contact__arc-text {
    fill: var(--ink);
  }

  .contact__arc-shadow {
    fill: var(--field-lo);
  }

  /* Links share one look: a bordered block with a hard shadow that the block
     sinks into when pressed. */
  .cta,
  .profile {
    display: grid;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow) var(--shadow) 0 var(--ink);
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.14s ease-out;
  }

  .cta {
    container-type: inline-size;
    gap: 0.1em;
    padding: clamp(0.875rem, 2vw, 1.5rem) clamp(1rem, 2.6vw, 2.25rem) clamp(1rem, 2.2vw, 1.75rem);
    background: var(--ink);
    color: var(--field);
    box-shadow: var(--shadow) var(--shadow) 0 var(--field-lo);
    --focus: var(--ink);
  }

  .cta__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--paper);
  }

  /* Sized from the block's own width so the address always fits on one line. */
  .cta__address {
    font-size: clamp(0.9rem, 9.8cqw, 5.75rem);
    font-weight: 900;
    line-height: 0.95;
    white-space: nowrap;
  }

  .arrow {
    width: 1.1em;
    height: 1.1em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    transition: transform 0.14s ease-out;
  }

  .profiles {
    display: grid;
    gap: clamp(0.875rem, 1.6vw, 1.5rem);
  }

  .profile {
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.15rem 1rem;
    padding: clamp(0.75rem, 1.5vw, 1.125rem) clamp(1rem, 2vw, 1.5rem);
    background: var(--field);
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 2.75rem);
    text-transform: uppercase;
  }

  .profile__text {
    grid-column: 1;
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 400;
    line-height: 1.3;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .profile .arrow {
    grid-area: 1 / 2 / span 2;
  }

  @media (min-width: 40rem) {
    .profiles {
      grid-template-columns: 1fr 1fr;
    }

    .profiles__wide {
      grid-column: 1 / -1;
    }
  }

  @media (hover: hover) {
    .cta:hover,
    .profile:hover {
      transform: translate(-2px, -2px);
    }

    .profile:hover {
      background: var(--ink);
      color: var(--field);
    }

    .cta:hover .arrow {
      transform: translateX(0.25em);
    }

    .profile:hover .arrow {
      transform: translate(0.12em, -0.12em);
    }
  }

  .cta:active,
  .profile:active {
    transform: translate(var(--shadow), var(--shadow));
  }

  /* The keyboard Toy's readout: a black strip the typed keys land on. Hidden
     (but holding its space) until the Toy script marks it ready. */
  .readout {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
    padding: 0.35em 0.6em;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    line-height: 1.15;
    visibility: hidden;
  }

  .readout[data-ready] {
    visibility: visible;
  }

  .readout__prompt {
    flex: none;
    color: var(--field-hi);
  }

  /* The Toy drops the oldest characters once a line no longer fits. */
  .readout__line {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: pre;
  }

  .readout__caret {
    flex: none;
    width: 0.55em;
    height: 1em;
    margin-left: 0.06em;
    background: var(--field-hi);
    animation: caret 1s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .readout__caret {
      animation: none;
    }

    .cta,
    .profile,
    .arrow {
      transition: none;
    }
  }
</style>
