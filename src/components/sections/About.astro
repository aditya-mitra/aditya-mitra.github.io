---
// About Section. Tickets 06 (bio, Roster, Ticker of Honours) and 07 (Scene, Toy) fill this in.
import AboutScene from '../scenes/AboutScene.astro';
import { site } from '../../data/site';

const { about } = site;
---

<section id="about" class="section about" aria-label={about.label}>
  <AboutScene />
  <h2 class="about__heading">{about.heading}</h2>
</section>

<style>
  .about__heading {
    font-size: var(--text-heading);
  }
</style>
